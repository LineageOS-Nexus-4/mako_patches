+// ---------------------------------------------------------------------------
+// Legacy (pre-RIL v11) data call response parsing.
+//
+// The mako QC RIL (KK-era, RIL version 11) returns setupDataCall /
+// getDataCallList / dataCallListChanged responses in an older fixed-size
+// struct format instead of the RIL_Data_Call_Response_v11 struct:
+//   int status, int suggestedRetryTime, int cid, int active,
+//   char *type, char *ifname, char *addresses, char *dnses, char *gateways
+// (9 words; no pcscf, no mtu). Some builds may return the legacy string-array
+// format instead. Optional fields use the (char*)-1 sentinel, and pointers
+// must always be validated before dereferencing.
+// ---------------------------------------------------------------------------
+static bool isLegacyString(char *s) {
+    return s != NULL && s != (char *)-1 && (uintptr_t)s >= 0x10000;
+}
+
+static void convertLegacyStringArrayToHal(char **dc, size_t numStrings,
+                                          SetupDataCallResult &result) {
+    result.status = DataCallFailCause::NONE;
+    result.suggestedRetryTime = 0;
+    result.cid = 0;
+    result.active = 0;
+    result.type = hidl_string();
+    result.ifname = hidl_string();
+    result.addresses = hidl_string();
+    result.dnses = hidl_string();
+    result.gateways = hidl_string();
+    result.pcscf = hidl_string();
+    result.mtu = 0;
+
+    if (numStrings > 0 && isLegacyString(dc[0])) result.status = (DataCallFailCause)atoi(dc[0]);
+    if (numStrings > 1 && isLegacyString(dc[1])) result.suggestedRetryTime = atoi(dc[1]);
+    if (numStrings > 2 && isLegacyString(dc[2])) result.cid = atoi(dc[2]);
+    if (numStrings > 3 && isLegacyString(dc[3])) result.active = atoi(dc[3]);
+    if (numStrings > 4 && isLegacyString(dc[4])) result.type = convertCharPtrToHidlString(dc[4]);
+    if (numStrings > 5 && isLegacyString(dc[5])) result.ifname = convertCharPtrToHidlString(dc[5]);
+    if (numStrings > 6 && isLegacyString(dc[6])) {
+        result.addresses = convertCharPtrToHidlString(dc[6]);
+    }
+    if (numStrings > 7 && isLegacyString(dc[7])) result.dnses = convertCharPtrToHidlString(dc[7]);
+    if (numStrings > 8 && isLegacyString(dc[8])) {
+        result.gateways = convertCharPtrToHidlString(dc[8]);
+    }
+    if (numStrings > 9 && isLegacyString(dc[9])) result.pcscf = convertCharPtrToHidlString(dc[9]);
+    if (numStrings > 10 && isLegacyString(dc[10])) result.mtu = atoi(dc[10]);
+}
+
+static void convertLegacyStructToHal(char *raw, SetupDataCallResult &result) {
+    int32_t *words = (int32_t *)raw;
+    result.status = (DataCallFailCause)words[0];
+    result.suggestedRetryTime = words[1];
+    result.cid = words[2];
+    result.active = words[3];
+    result.type = hidl_string();
+    result.ifname = hidl_string();
+    result.addresses = hidl_string();
+    result.dnses = hidl_string();
+    result.gateways = hidl_string();
+    result.pcscf = hidl_string();
+    result.mtu = 0;
+    if (isLegacyString((char *)words[4])) result.type = convertCharPtrToHidlString((char *)words[4]);
+    if (isLegacyString((char *)words[5])) result.ifname = convertCharPtrToHidlString((char *)words[5]);
+    if (isLegacyString((char *)words[6])) {
+        result.addresses = convertCharPtrToHidlString((char *)words[6]);
+    }
+    if (isLegacyString((char *)words[7])) result.dnses = convertCharPtrToHidlString((char *)words[7]);
+    if (isLegacyString((char *)words[8])) {
+        result.gateways = convertCharPtrToHidlString((char *)words[8]);
+    }
+}
+
+static bool isPlausibleCallBlock(char **dc, size_t offset, size_t numStrings) {
+    // A legacy string-array call block must at least carry a numeric status
+    // and cid at the expected offsets.
+    if (offset + 6 > numStrings) return false;
+    if (!isLegacyString(dc[offset])) return false;
+    const int status = atoi(dc[offset]);
+    if (status == 0 && dc[offset][0] != '0') return false;
+    if (!isLegacyString(dc[offset + 2])) return false;
+    (void)atoi(dc[offset + 2]);
+    return true;
+}
+
+static void parseLegacyDataCallList(char *response, size_t responseLen,
+                                    hidl_vec<SetupDataCallResult> &list) {
+    std::vector<SetupDataCallResult> out;
+    if (responseLen % (9 * sizeof(int32_t)) == 0 && responseLen >= 9 * sizeof(int32_t)) {
+        // Fixed 9-word struct per call (mako QC RIL).
+        int num = responseLen / (9 * sizeof(int32_t));
+        for (int i = 0; i < num; i++) {
+            SetupDataCallResult result;
+            convertLegacyStructToHal(response + i * 9 * sizeof(int32_t), result);
+            out.push_back(result);
+        }
+    } else {
+        // NULL-terminated string-array format.
+        char **dc = (char **)response;
+        size_t numStrings = responseLen / sizeof(char *);
+        size_t offset = 0;
+        while (offset < numStrings && isLegacyString(dc[offset])) {
+            size_t stride = 10;
+            if (!isPlausibleCallBlock(dc, offset + stride, numStrings) &&
+                isPlausibleCallBlock(dc, offset + 9, numStrings)) {
+                stride = 9;
+            } else if (!isPlausibleCallBlock(dc, offset + stride, numStrings) &&
+                       isPlausibleCallBlock(dc, offset + 11, numStrings)) {
+                stride = 11;
+            }
+            SetupDataCallResult result;
+            convertLegacyStringArrayToHal(&dc[offset], stride, result);
+            out.push_back(result);
+            offset += stride;
+        }
+    }
+    list.resize(out.size());
+    for (size_t i = 0; i < out.size(); i++) list[i] = out[i];
+}
