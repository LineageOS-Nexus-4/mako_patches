@@ -0,0 +1,16 @@
+soong_namespace {
+}
+
+// SurfaceFlinger consumes the legacy gralloc private ABI on mako. Keep the
+// interface scoped to the msm8960 namespace instead of exposing every old HAL.
+cc_library_headers {
+    name: "display_intf_headers",
+    vendor_available: true,
+    export_include_dirs: [
+        "libgralloc",
+        "libqdutils",
+        "libqservice",
+    ],
+    header_libs: ["libhardware_headers"],
+    export_header_lib_headers: ["libhardware_headers"],
+}
