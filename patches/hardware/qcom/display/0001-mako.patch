diff --git a/msm8960/libgralloc/mapper.cpp b/msm8960/libgralloc/mapper.cpp
index f2d6e23031a9f886eed6fb32ef8bfc6753f6e053..eb24ae1b8deb57d5082514112ef17f522952222b 100644
--- a/msm8960/libgralloc/mapper.cpp
+++ b/msm8960/libgralloc/mapper.cpp
@@ -252,9 +252,20 @@ int gralloc_lock_ycbcr(gralloc_module_t const* module,
     int err = gralloc_map_and_invalidate(module, handle, usage, l, t, w, h);
     int ystride, cstride;
     if(!err) {
-        //hnd->format holds our implementation defined format
-        //HAL_PIXEL_FORMAT_YCrCb_420_SP is the only one set right now.
+        // hnd->format holds the concrete implementation-defined layout.
         switch (hnd->format) {
+            case HAL_PIXEL_FORMAT_NV12_ENCODEABLE:
+                // Match getBufferSizeAndDimensions(): the msm8960 encoder
+                // needs the UV plane at a 2K-aligned offset, unlike plain NV12.
+                ystride = ALIGN(hnd->width, 16);
+                ycbcr->y  = (void*)hnd->base;
+                ycbcr->cb = (void*)(hnd->base + ALIGN(ystride * hnd->height, 2048));
+                ycbcr->cr = (void*)(hnd->base + ALIGN(ystride * hnd->height, 2048) + 1);
+                ycbcr->ystride = ystride;
+                ycbcr->cstride = ystride;
+                ycbcr->chroma_step = 2;
+                memset(ycbcr->reserved, 0, sizeof(ycbcr->reserved));
+                break;
             case HAL_PIXEL_FORMAT_YCrCb_420_SP:
                 ystride = ALIGN(hnd->width, 16);
                 ycbcr->y  = (void*)hnd->base;
