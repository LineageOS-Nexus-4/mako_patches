-		} else {
-			drv_errors = 0;
-			if((os_strncasecmp(cmd, "SETBAND", 7) == 0) &&
-				ret == DO_NOT_SEND_CHANNEL_CHANGE_EVENT) {
-				return 0;
-			}
-
-			ret = 0;
-			if ((os_strcasecmp(cmd, "LINKSPEED") == 0) ||
