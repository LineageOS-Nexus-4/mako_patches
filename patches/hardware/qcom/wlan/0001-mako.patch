-			else if (os_strcasecmp(cmd, "P2P_SET_NOA") == 0)
-				wpa_printf(MSG_DEBUG, "%s: P2P: %s ", __func__, buf);
-			else if (os_strcasecmp(cmd, "STOP") == 0) {
