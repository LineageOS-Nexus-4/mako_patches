-				event.channel_list_changed.alpha2[0] = cmd[8];
-				event.channel_list_changed.alpha2[1] = cmd[9];
-			}
-		} else {
-			event.channel_list_changed.type = REGDOM_TYPE_UNKNOWN;
-		}
