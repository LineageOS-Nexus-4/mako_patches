     // clang-format on
+    // Without the pinned ingress program,
+    // xt_bpf rules cannot be installed. Retain the ordinary iptables rules;
+    // BPF UID filtering/accounting remains unavailable in this mode.
+    if (access(XT_BPF_INGRESS_PROG_PATH, F_OK) != 0) {
+        ipt_basic_accounting_commands.erase(
